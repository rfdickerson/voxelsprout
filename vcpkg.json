{
  "name": "odai-bethesda-engine",
  "version-string": "0.1.0",
  "builtin-baseline": "b02e341c927f16d991edbd915d8ea43eac52096c",
  "dependencies": [
    "bcdec",
    "joltphysics",
    "nlohmann-json",
    "zlib"
  ],
  "default-features": ["presentation"],
  "features": {
    "presentation": {
      "description": "Window, audio, UI, and Vulkan presentation dependencies",
      "dependencies": [
        { "name": "glfw3", "features": ["wayland"] },
        { "name": "imgui", "features": ["glfw-binding", "vulkan-binding"] },
        "miniaudio",
        "stb",
        "vulkan",
        "vulkan-memory-allocator"
      ]
    }
  },
  "overrides": [
    {
      "name": "imgui",
      "version": "1.91.9"
    }
  ]
}
